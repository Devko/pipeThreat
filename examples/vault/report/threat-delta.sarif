{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "threat-model-delta",
          "informationUri": "https://github.com/Devko/pipeThreat",
          "rules": [
            {
              "id": "assumption_violation",
              "name": "AssumptionViolation",
              "shortDescription": {
                "text": "assumption violation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Devko/pipeThreat/blob/main/docs/deltas.md#assumption_violation"
            },
            {
              "id": "new_entry_point",
              "name": "NewEntryPoint",
              "shortDescription": {
                "text": "new entry point"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Devko/pipeThreat/blob/main/docs/deltas.md#new_entry_point"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.acl_enforced': reads storage directly with no ACL policy evaluation"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http/sys_inspect.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-29101-1"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.acl_enforced",
            "requires_human_review": true,
            "affected_elements": [
              "comp.http_api"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.tokens` (critical-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.acl_enforced",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.all_access_audited': returns secret data without writing an audit entry"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http/sys_inspect.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-29101-2"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.all_access_audited",
            "requires_human_review": true,
            "affected_elements": [
              "comp.http_api"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.tokens` (critical-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.all_access_audited",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.all_requests_authenticated': new endpoint requires no token"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http/sys_inspect.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-29101-3"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.all_requests_authenticated",
            "requires_human_review": true,
            "affected_elements": [
              "comp.http_api"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.tokens` (critical-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.all_requests_authenticated",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "new_entry_point",
          "level": "warning",
          "message": {
            "text": "3 change-signals on HTTP API (edge zone): new entry point, trust-boundary crossing, control change. STRIDE: InformationDisclosure: returns raw decrypted secrets read straight from the storage barrier; ElevationOfPrivilege: reads any storage path with no token and no ACL policy check; Repudiation: secret access is not written to the audit log"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "http/sys_inspect.go"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-29101-4"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [
              "InformationDisclosure",
              "ElevationOfPrivilege",
              "Repudiation"
            ],
            "contradicts_assumption": null,
            "requires_human_review": true,
            "affected_elements": [
              "comp.http_api"
            ],
            "recommended_action": "Confirm the new entry point is intended; add explicit authz + input validation, or route it through the gateway.",
            "severity_rationale": "touches `asset.tokens` (critical-sensitivity) \u2192 at least High",
            "change_signals": [
              "new entry point",
              "trust-boundary crossing",
              "control change"
            ],
            "proposed_baseline_update": {
              "kind": "component_entry_point_added",
              "target": "comp.http_api",
              "change": "entry_points += http_api; document the new boundary crossing; review affecting controls"
            }
          }
        }
      ]
    }
  ]
}
