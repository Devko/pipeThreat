{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "threat-model-delta",
          "informationUri": "https://github.com/Devko/pipeThreat",
          "rules": [
            {
              "id": "assumption_violation",
              "name": "AssumptionViolation",
              "shortDescription": {
                "text": "assumption violation"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Devko/pipeThreat/blob/main/docs/deltas.md#assumption_violation"
            },
            {
              "id": "new_entry_point",
              "name": "NewEntryPoint",
              "shortDescription": {
                "text": "new entry point"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/Devko/pipeThreat/blob/main/docs/deltas.md#new_entry_point"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.no_unauthenticated_execution': an anonymous request triggers workflow execution"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/cli/src/webhooks/PublicTriggerHandler.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-8421-1"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.no_unauthenticated_execution",
            "requires_human_review": true,
            "affected_elements": [
              "comp.webhooks"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.workflow_data` (high-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.no_unauthenticated_execution",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.public_endpoints_rate_limited': the public endpoint applies no rate limit"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/cli/src/webhooks/PublicTriggerHandler.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-8421-2"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.public_endpoints_rate_limited",
            "requires_human_review": true,
            "affected_elements": [
              "comp.webhooks"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.workflow_data` (high-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.public_endpoints_rate_limited",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "assumption_violation",
          "level": "warning",
          "message": {
            "text": "Change weakens or violates assumption 'asm.webhooks_authenticated': endpoint verifies no token or signature"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/cli/src/webhooks/PublicTriggerHandler.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-8421-3"
          },
          "properties": {
            "severity": "high",
            "confidence": "high",
            "stride": [],
            "contradicts_assumption": "asm.webhooks_authenticated",
            "requires_human_review": true,
            "affected_elements": [
              "comp.webhooks"
            ],
            "recommended_action": "Restore the assumption or, if the change is a legitimate evolution, update the baseline assumption and obtain security review.",
            "severity_rationale": "assumption guards `asset.workflow_data` (high-sensitivity) \u2192 High",
            "proposed_baseline_update": {
              "kind": "assumption_revisited",
              "target": "asm.webhooks_authenticated",
              "change": "confirm intended; update or reaffirm the assumption"
            }
          }
        },
        {
          "ruleId": "new_entry_point",
          "level": "warning",
          "message": {
            "text": "3 change-signals on Webhook receiver (edge zone): new entry point, trust-boundary crossing, control change. STRIDE: Spoofing: no authentication or signature check \u2014 any caller can trigger a workflow; Tampering: attacker-controlled request body is passed straight in as workflow trigger data; DenialOfService: unauthenticated synchronous execution with no rate limit; ElevationOfPrivilege: triggers workflows that run with stored credentials"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/cli/src/webhooks/PublicTriggerHandler.ts"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "deltaId": "td-8421-4"
          },
          "properties": {
            "severity": "medium",
            "confidence": "high",
            "stride": [
              "Spoofing",
              "Tampering",
              "DenialOfService",
              "ElevationOfPrivilege"
            ],
            "contradicts_assumption": null,
            "requires_human_review": false,
            "affected_elements": [
              "comp.webhooks"
            ],
            "recommended_action": "Confirm the new entry point is intended; add explicit authz + input validation, or route it through the gateway.",
            "severity_rationale": "touches `asset.workflow_data` (high-sensitivity) \u2192 at least Medium",
            "change_signals": [
              "new entry point",
              "trust-boundary crossing",
              "control change"
            ],
            "proposed_baseline_update": {
              "kind": "component_entry_point_added",
              "target": "comp.webhooks",
              "change": "entry_points += http_webhook; document the new boundary crossing; review affecting controls"
            }
          }
        }
      ]
    }
  ]
}
